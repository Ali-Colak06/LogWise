# Netlify — Redirect & Rewrite Kuralları

# index.php → kök dizine 301 yönlendirme
/index.php    /   301

# NOT: /app, /profile, /share ve /program için kural YOK — Netlify, .html
# dosyalarını otomatik olarak clean URL olarak sunuyor.
# Burada kural eklemek redirect döngüsüne neden olur.

# Statik TR landing
/tr           /tr.html        200
/tr/          /tr.html        200

# /app/* SPA route'ları — yeni URL şeması (wildcard)
/app/*        /app.html       200

# Eski SPA route'ları — geriye dönük uyumluluk
/social       /app.html       200
/dashboard    /app.html       200
/exercises    /app.html       200
/programs     /app.html       200
/feedback     /app.html       200
/data         /app.html       200

# NOT: 404 sayfası için ayrı satır gerekmez.
