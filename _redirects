# Cloudflare Pages — Redirect & Rewrite Kuralları

# index.html / index.php → kök dizine 301 yönlendirme
/index.html   /   301
/index.php    /   301

# Profil sayfası — /profile URL'i profile.html'i yükler (clean URL)
/profile      /profile.html   200

# Paylaşılan antrenman sayfası — /share URL'i share.html'i yükler
/share        /share.html     200

# SPA route'ları — React client-side routing
/social       /index.html     200
/dashboard    /index.html     200
/exercises    /index.html     200
/programs     /index.html     200
/feedback     /index.html     200
/data         /index.html     200

# NOT: 404 sayfası için ayrı satır gerekmez.
# Cloudflare Pages, kök dizindeki 404.html dosyasını otomatik olarak kullanır.
