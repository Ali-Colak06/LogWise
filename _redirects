# Netlify — Redirect & Rewrite Kuralları

# index.php → kök dizine 301 yönlendirme
/index.php    /   301

# NOT: /app, /profile, /share ve /program için kural YOK — Netlify, .html
# dosyalarını otomatik olarak clean URL olarak sunuyor.
# Burada kural eklemek redirect döngüsüne neden olur.

# NOT: /tr için kural yok.
# Cloudflare Pages, tr.html dosyasını otomatik olarak /tr clean URL'den sunar.
# /tr -> /tr.html 200 kuralı, .html canonical redirect'iyle 307 döngüsü yaratır.

# /app/* SPA route'ları — yeni URL şeması (wildcard)
/app/*        /app.html       200

# Eski programmatic SEO URL'leri → yeni /guides bilgi mimarisi
/exercises                    /guides/exercises                    301
/programs                     /guides/programs                     301
/exercises/bench-press        /guides/exercises/bench-press        301
/exercises/squat              /guides/exercises/squat              301
/exercises/deadlift           /guides/exercises/deadlift           301
/programs/push-pull-legs      /guides/programs/push-pull-legs      301

# Eski SPA route'ları — geriye dönük uyumluluk
/social       /app.html       200
/dashboard    /app.html       200
/feedback     /app.html       200
/data         /app.html       200

# NOT: 404 sayfası için ayrı satır gerekmez.
# Netlify, kök dizindeki 404.html dosyasını otomatik olarak kullanır.
