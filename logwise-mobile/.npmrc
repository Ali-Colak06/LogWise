# Expo SDK 56 + RN ekosistemi peer dependency çatışmalarını otomatik tolere et.
# Sebep: expo-router -> vaul -> @radix-ui/react-dialog -> react-dom@19.2.6, 
# react@19.2.3 (Expo'nun verdiği) ile peer çakışır. Bu Expo'nun kendi içindeki
# bir uyumsuzluk; npm install bunu bayrak olmadan reddediyor.
# Bayrak --legacy-peer-deps ile her seferde yazmak yerine, repo-default yapıyoruz.
legacy-peer-deps=true
