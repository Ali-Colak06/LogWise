# Cloudflare Pages — HTTP Header Kuralları
# netlify.toml'dan dönüştürüldü

# sw.js için cache kapatma — tarayıcı her zaman güncel SW'yi kontrol eder
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTML sayfaları için cache kapatma — kullanıcılar hep güncel sürümü görür
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Kök URL (index.html) için de cache kapatma
/
  Cache-Control: no-cache, no-store, must-revalidate

# Tüm sayfalar için güvenlik header'ları + statik varlıklar için cache
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=86400
